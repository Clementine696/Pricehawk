# Frontend Environment Variables

# API URL - leave empty for local development (uses relative /api paths)
# For deployed environments, uncomment the appropriate URL below

# Local development (empty = uses relative /api paths)
NEXT_PUBLIC_API_URL=

# UAT Environment (uncomment for UAT deployment)
# NEXT_PUBLIC_API_URL=https://pricehawk-uat.up.railway.app

# Production Environment (uncomment for PRD deployment)
# NEXT_PUBLIC_API_URL=https://pricehawk-production-d139.up.railway.app
